<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:MemoryMap.App"
        xmlns:core="using:MemoryMap.Core"
        x:Class="MemoryMap.App.MainWindow"
        x:DataType="app:MainViewModel"
        Title="Memory Map"
        Width="1180" Height="800" MinWidth="560" MinHeight="420"
        Background="{DynamicResource Map.Page}">
  <DockPanel Margin="16,12,16,16">
    <StackPanel DockPanel.Dock="Top" Spacing="2">
      <TextBlock x:Name="SummaryText" Text="{Binding Summary}" FontSize="15" FontWeight="SemiBold"
                 Foreground="{DynamicResource Map.Ink}" TextWrapping="Wrap" />
      <TextBlock x:Name="StatusText" Text="{Binding Status}" FontSize="12"
                 Foreground="{DynamicResource Map.Ink2}" TextWrapping="Wrap" />
      <Border x:Name="NoticeBar" IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}"
              Margin="0,6,0,0" Padding="10,4,4,4" CornerRadius="6"
              Background="{DynamicResource Map.Surface}" BorderBrush="{DynamicResource Map.Border}" BorderThickness="1">
        <DockPanel>
          <Button x:Name="DismissButton" DockPanel.Dock="Right" Content="Dismiss" Padding="8,2" Click="OnDismiss" />
          <TextBlock x:Name="NoticeText" Text="{Binding Notice, FallbackValue=''}" TextWrapping="Wrap"
                     VerticalAlignment="Center" Foreground="{DynamicResource Map.Ink}" />
        </DockPanel>
      </Border>
    </StackPanel>

    <ItemsControl x:Name="LegendList" DockPanel.Dock="Top" Margin="0,10,0,6" ItemsSource="{Binding Legend}"
                   IsVisible="{Binding ShowsGroupLegend}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel ItemSpacing="18" LineSpacing="4" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="app:LegendItem">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <app:GroupSwatch Group="{Binding Group}" VerticalAlignment="Center" />
            <TextBlock Foreground="{DynamicResource Map.Ink2}" FontSize="13">
              <Run Text="{Binding Label}" FontWeight="SemiBold" Foreground="{DynamicResource Map.Ink}" />
              <Run Text="{Binding Size}" />
              <Run Text="{Binding Share}" />
            </TextBlock>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TabControl x:Name="Views" Padding="0,6,0,0" SelectedIndex="{Binding ViewIndex, Mode=TwoWay}">
      <TabItem Header="Map">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
            <Button x:Name="BackButton" Content="&#x2039; Back" Padding="8,2" IsEnabled="{Binding CanGoBack}" Click="OnBack"
                    ToolTip.Tip="Back (Esc, Backspace or the mouse back button)" />
            <ItemsControl x:Name="BreadcrumbList" ItemsSource="{Binding Ancestors}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="app:Crumb">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Content="{Binding Name}" Padding="6,2" Click="OnCrumb"
                            Background="Transparent" Foreground="{DynamicResource Map.Ink2}" />
                    <TextBlock Text="&#x203A;" VerticalAlignment="Center" Foreground="{DynamicResource Map.Muted}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="CurrentCrumb" Text="{Binding ViewRoot.Name}" VerticalAlignment="Center"
                       FontWeight="SemiBold" Foreground="{DynamicResource Map.Ink}" />
          </StackPanel>
          <Panel>
            <app:TreemapControl x:Name="Map" Root="{Binding ViewRoot}" Total="{Binding Breakdown.Total}" />
            <Canvas IsHitTestVisible="False">
              <Border x:Name="Tip" IsVisible="{Binding Hover, Converter={x:Static ObjectConverters.IsNotNull}}" MaxWidth="360"
                      Background="{DynamicResource Map.Surface}" BorderBrush="{DynamicResource Map.Border}"
                      BorderThickness="1" CornerRadius="6" Padding="10,8" BoxShadow="0 4 16 0 #2E000000">
                <StackPanel Spacing="2">
                  <TextBlock x:Name="TipTitle" Text="{Binding Hover.Title, FallbackValue=''}" FontWeight="SemiBold" FontSize="13"
                             Foreground="{DynamicResource Map.Ink}" TextWrapping="Wrap" />
                  <TextBlock x:Name="TipText" Text="{Binding Hover.Text, FallbackValue=''}" FontSize="12"
                             Foreground="{DynamicResource Map.Ink2}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </Canvas>
          </Panel>
        </DockPanel>
      </TabItem>
      <TabItem Header="Table">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="170,*,100,70,80,280" Margin="8,4">
            <Grid.Styles>
              <Style Selector="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource Map.Ink2}" />
              </Style>
            </Grid.Styles>
            <TextBlock Grid.Column="0" Text="Group" />
            <TextBlock Grid.Column="1" Text="Name" />
            <TextBlock Grid.Column="2" Text="Size" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="3" Text="RAM" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="4" Text="Processes" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="5" Text="PIDs" Margin="16,0,0,0" />
          </Grid>
          <ScrollViewer>
            <ItemsControl x:Name="TableList" ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="core:TableRow">
                  <Border BorderBrush="{DynamicResource Map.Border}" BorderThickness="0,0,0,1" Padding="8,4">
                    <Grid ColumnDefinitions="170,*,100,70,80,280">
                      <Grid.Styles>
                        <Style Selector="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource Map.Ink}" />
                          <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        </Style>
                      </Grid.Styles>
                      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                        <app:GroupSwatch Group="{Binding Group}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding GroupLabel}" Foreground="{DynamicResource Map.Ink2}" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding Name}" />
                      <TextBlock Grid.Column="2" Text="{Binding Size}" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="3" Text="{Binding Share}" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="4" Text="{Binding Processes}" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="5" Text="{Binding Pids}" Margin="16,0,0,0" Foreground="{DynamicResource Map.Ink2}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>
      <TabItem Header="History">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <ComboBox x:Name="WindowPicker" DockPanel.Dock="Right" VerticalAlignment="Top"
                      ItemsSource="{Binding Settings.WindowLabels}" SelectedIndex="{Binding Settings.WindowIndex, Mode=TwoWay}" />
            <!-- The legend always names every line and its newest value: identity is never colour alone. -->
            <ItemsControl x:Name="SeriesLegend" ItemsSource="{Binding History.Legend}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel ItemSpacing="18" LineSpacing="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="app:SeriesLegendItem">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <app:SeriesSwatch Slot="{Binding Slot}" VerticalAlignment="Center" />
                    <TextBlock Foreground="{DynamicResource Map.Ink2}" FontSize="13">
                      <Run Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Map.Ink}" />
                      <Run Text="{Binding Latest}" />
                    </TextBlock>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
          <Panel>
            <app:HistoryChartControl x:Name="Chart" Chart="{Binding History.Chart}" />
            <Canvas IsHitTestVisible="False">
              <Border x:Name="ChartTip" IsVisible="{Binding History.Hover, Converter={x:Static ObjectConverters.IsNotNull}}"
                      Background="{DynamicResource Map.Surface}" BorderBrush="{DynamicResource Map.Border}"
                      BorderThickness="1" CornerRadius="6" Padding="10,8" BoxShadow="0 4 16 0 #2E000000">
                <StackPanel Spacing="2">
                  <TextBlock x:Name="ChartTipTitle" Text="{Binding History.Hover.Title, FallbackValue=''}" FontWeight="SemiBold" FontSize="13"
                             Foreground="{DynamicResource Map.Ink}" />
                  <TextBlock x:Name="ChartTipText" Text="{Binding History.Hover.Text, FallbackValue=''}" FontSize="12"
                             Foreground="{DynamicResource Map.Ink2}" />
                </StackPanel>
              </Border>
            </Canvas>
          </Panel>
        </DockPanel>
      </TabItem>
      <TabItem Header="Startup">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button x:Name="StartupRefreshButton" DockPanel.Dock="Right" Content="Refresh" Padding="10,2"
                    IsEnabled="{Binding !Startup.IsLoading}" Click="OnStartupRefresh" />
            <TextBlock x:Name="StartupMessage" Text="{Binding Startup.Message}" VerticalAlignment="Center"
                       TextWrapping="Wrap" Foreground="{DynamicResource Map.Ink2}" />
          </DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,170,90,110,260" Margin="8,4">
            <Grid.Styles>
              <Style Selector="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource Map.Ink2}" />
              </Style>
            </Grid.Styles>
            <TextBlock Grid.Column="0" Text="Name" />
            <TextBlock Grid.Column="1" Text="Now" />
            <TextBlock Grid.Column="2" Text="Memory" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="3" Text="At sign-in" Margin="16,0,0,0" />
          </Grid>
          <ScrollViewer>
            <ItemsControl x:Name="StartupList" ItemsSource="{Binding Startup.Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="app:StartupItem">
                  <Border BorderBrush="{DynamicResource Map.Border}" BorderThickness="0,0,0,1" Padding="8,4">
                    <Grid ColumnDefinitions="*,170,90,110,260">
                      <Grid.Styles>
                        <Style Selector="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource Map.Ink}" />
                          <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                          <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                      </Grid.Styles>
                      <StackPanel Grid.Column="0" Spacing="1">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource Map.Ink2}" ToolTip.Tip="{Binding Detail}" />
                        <TextBlock Text="{Binding Problem, FallbackValue=''}" FontSize="12" TextWrapping="Wrap"
                                   IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   Foreground="{DynamicResource Map.Critical}" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding Status}" ToolTip.Tip="{Binding StatusHint}" />
                      <TextBlock Grid.Column="2" Text="{Binding Memory}" HorizontalAlignment="Right" />
                      <ToggleSwitch Grid.Column="3" Margin="16,0,0,0" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                    IsEnabled="{Binding CanSwitch}" ToolTip.Tip="{Binding SwitchHint}" ToolTip.ShowOnDisabled="True"
                                    AutomationProperties.Name="{Binding Name}" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Content="Show on map" Padding="8,2" IsEnabled="{Binding CanShowOnMap}" Click="OnStartupShowOnMap" />
                        <Button Content="Open file location" Padding="8,2" Click="OnStartupLocate" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>
      <TabItem Header="Settings">
        <ScrollViewer>
          <StackPanel x:Name="SettingsPanel" Spacing="14" Margin="4,8" MaxWidth="560" HorizontalAlignment="Left">
            <StackPanel.Styles>
              <Style Selector="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Map.Ink}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
              </Style>
            </StackPanel.Styles>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="Refresh every" />
              <ComboBox x:Name="RefreshPicker" ItemsSource="{Binding Settings.RefreshLabels}"
                        SelectedIndex="{Binding Settings.RefreshIndex, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="While hidden or minimised" />
              <ComboBox x:Name="HiddenRefreshPicker" ItemsSource="{Binding Settings.HiddenRefreshLabels}"
                        SelectedIndex="{Binding Settings.HiddenRefreshIndex, Mode=TwoWay}" />
            </StackPanel>
            <CheckBox x:Name="AlertsBox" IsChecked="{Binding Settings.AlertsEnabled, Mode=TwoWay}"
                      Content="Warn when available memory runs low" />
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="28,0,0,0" IsEnabled="{Binding Settings.AlertsEnabled}">
              <TextBlock Text="Warn below" />
              <NumericUpDown x:Name="AlertPercentBox" Value="{Binding Settings.AlertBelowPercent, Mode=TwoWay}"
                             Minimum="{x:Static app:SettingsViewModel.MinAlertPercent}" Maximum="{x:Static app:SettingsViewModel.MaxAlertPercent}"
                             Increment="1" FormatString="0" Width="130" />
              <TextBlock Text="% of RAM available" />
            </StackPanel>
            <CheckBox x:Name="TrayBox" IsChecked="{Binding Settings.CloseToTray, Mode=TwoWay}"
                      Content="Closing the window keeps Memory Map running in the tray" />
            <TextBlock x:Name="SettingsProblem" Text="{Binding Settings.Problem, FallbackValue=''}"
                       IsVisible="{Binding Settings.Problem, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Foreground="{DynamicResource Map.Critical}" />
            <TextBlock FontSize="12" Foreground="{DynamicResource Map.Ink2}"
                       Text="Changes apply at once and are saved to %APPDATA%\MemoryMap\settings.json." />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
