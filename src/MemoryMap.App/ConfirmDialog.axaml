<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MemoryMap.App.ConfirmDialog"
        Icon="avares://MemoryMap/Assets/memory-map.ico"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Map.Page}">
  <StackPanel Margin="20,16" Spacing="14">
    <TextBlock x:Name="Question" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
               Foreground="{DynamicResource Map.Ink}" />
    <TextBlock x:Name="Detail" TextWrapping="Wrap" Foreground="{DynamicResource Map.Ink2}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <!-- Cancel is the default: Enter or Escape alone never ends a process. -->
      <Button x:Name="CancelButton" Content="Cancel" IsDefault="True" IsCancel="True" />
      <Button x:Name="ConfirmButton" Classes="accent" />
    </StackPanel>
  </StackPanel>
</Window>
