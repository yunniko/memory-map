<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The app samples memory through the Windows-only sampler (G-001 constraint). -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>MemoryMap.App</RootNamespace>
    <AssemblyName>MemoryMap</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MemoryMap.Core\MemoryMap.Core.csproj" />
    <ProjectReference Include="..\MemoryMap.Windows\MemoryMap.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MemoryMap.App.Tests" />
  </ItemGroup>

</Project>
