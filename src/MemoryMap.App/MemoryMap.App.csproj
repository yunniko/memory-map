<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>MemoryMap.App</RootNamespace>
    <AssemblyName>MemoryMap</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Published as Native AOT (D043); also turns on the AOT and trim analyzers in every build. -->
    <PublishAot>true</PublishAot>
    <!-- Made from assets/memory-map.svg by scripts/make-icon.ps1 (D046). -->
    <ApplicationIcon>..\..\assets\memory-map.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <!-- ANGLE (OpenGL over Direct3D) is never loaded: the app renders in software (Program.cs, D043). -->
    <PackageReference Include="Avalonia.Angle.Windows.Natives" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The windows' icon: their title bar and taskbar button, and on Linux the X11 window icon. -->
    <AvaloniaResource Include="..\..\assets\memory-map.ico" Link="Assets\memory-map.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MemoryMap.Core\MemoryMap.Core.csproj" />
    <ProjectReference Include="..\MemoryMap.Linux\MemoryMap.Linux.csproj" />
    <ProjectReference Include="..\MemoryMap.Windows\MemoryMap.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MemoryMap.App.Tests" />
  </ItemGroup>

</Project>
