<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>0.4.1</Version>
    <!-- The exe's product name and version are what SignPath's signing policy checks (D040). -->
    <Product>Memory Map</Product>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>yunniko and Claude (Anthropic)</Authors>
    <Copyright>Copyright (c) 2026 yunniko and Claude (Anthropic)</Copyright>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- The app ships as Native AOT (D043): every build analyses the code compiled into it. memmap-dump
       (MemoryMap.Cli) is a development tool that ships in no release. -->
  <PropertyGroup Condition="$([MSBuild]::MakeRelative($(MSBuildThisFileDirectory), $(MSBuildProjectDirectory)).StartsWith('src')) and '$(MSBuildProjectName)' != 'MemoryMap.Cli'">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
</Project>
